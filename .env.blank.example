BLANK_POSTGRES_USER=enterprise
BLANK_POSTGRES_PASSWORD=replace-with-a-long-random-password
BLANK_POSTGRES_DB=enterprise_blank
# 生产默认禁用本地认证；development / demo / break_glass 只用于对应受控场景。
BLANK_RUNTIME_ENV=production
BLANK_LOCAL_AUTH_MODE=disabled
# 签名根密钥；至少 32 字节且不得使用公开示例。session / OIDC state / Passkey 挑战
# 各自按用途派生独立密钥，本地认证禁用（OIDC-only）时同样在启动时强制校验。
BLANK_JWT_SECRET=
# 轮换期的历史根密钥（逗号分隔，可留空）：只用于验签，让旧 session token 在轮换后仍可用。
BLANK_JWT_SECRET_PREVIOUS=
BLANK_ADMIN_USERNAME=admin
BLANK_ADMIN_PASSWORD=
BLANK_ADMIN_EMAIL=
# 使用 Fernet.generate_key() 生成；缺失时集成凭据保存/读取必须 fail-closed。
BLANK_INTEGRATION_ENVELOPE_KEY=
# disabled / jwt / header。生产启用时必须同时配置 issuer、audience 与独立强密钥。
BLANK_PRINCIPAL_MODE=disabled
BLANK_PRINCIPAL_HEADER=X-Enterprise-Principal-JWT
BLANK_PRINCIPAL_ISSUER=
BLANK_PRINCIPAL_AUDIENCE=
BLANK_PRINCIPAL_SECRET=
BLANK_WEBAUTHN_RP_ID=localhost
BLANK_WEBAUTHN_RP_NAME=Enterprise Platform
BLANK_WEBAUTHN_ORIGINS=http://localhost:3100
BLANK_FRONTEND_PORT=3100
BLANK_BACKEND_PORT=8100
